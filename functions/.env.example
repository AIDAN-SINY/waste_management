# Copy to functions/.env (gitignored).
# "demo" = demo.campay.net (amount capped at 25 XAF), "production" = www.campay.net
CAMPAY_ENV=demo

# Credentials are NOT set here — they are Firebase secrets:
#   firebase functions:secrets:set CAMPAY_USERNAME
#   firebase functions:secrets:set CAMPAY_PASSWORD
#   firebase functions:secrets:set CAMPAY_WEBHOOK_KEY
#   firebase functions:secrets:set HF_TOKEN      (WasteBot AI)
# For the local emulator only, put them in functions/.secret.local.

# WasteBot AI model (optional)
HF_MODEL=Qwen/Qwen2.5-7B-Instruct:fastest

# WhatsApp Cloud API (optional — notifications also go out by SMS + push)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# SMS (Vonage): "forgot password" codes and notifications. Without them,
# the password reset code cannot be delivered.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SENDER=WastePro

# DEVELOPMENT ONLY: a fixed 6-digit code also accepted as a password reset
# code (test numbers never receive SMS). Leave EMPTY in production.
SMS_DEV_CODE=
