# Settings for the LOCAL server (npm run local).
# Copy to functions/.env.server (gitignored) and fill in. Never commit it.

# CamPay — "demo" = demo.campay.net (each payment capped at 25 XAF).
# Keys: CamPay dashboard (demo account) → API access.
CAMPAY_ENV=demo
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
# Optional: permanent access token (dashboard → API access). Used instead
# of username/password when set.
CAMPAY_TOKEN=
CAMPAY_WEBHOOK_KEY=

# WasteBot AI (optional): Hugging Face token (Settings → Access Tokens).
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct:fastest

# SMS (optional). Without Vonage keys no SMS is sent; the code below is
# then accepted for "Forgot password" (demo only).
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SENDER=WastePro
SMS_DEV_CODE=123456

# WhatsApp (optional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
